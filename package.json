{
  "name": "simplenote-mcp",
  "version": "1.0.0",
  "description": "MCP server for reading Simplenote data from the local macOS store",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "simplenote-mcp": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "mcp",
    "simplenote",
    "notes",
    "claude",
    "model-context-protocol"
  ],
  "author": "Mark Biek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markbiek/simplenote-mcp.git"
  },
  "homepage": "https://github.com/markbiek/simplenote-mcp#readme",
  "bugs": {
    "url": "https://github.com/markbiek/simplenote-mcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "fast-xml-parser": "^5.3.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
